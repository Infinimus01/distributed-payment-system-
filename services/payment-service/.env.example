# Payment Service Configuration

# Server
NODE_ENV=development
PORT=3001
SERVICE_NAME=payment-service

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payment_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=payment:

# Payment Processing
PAYMENT_TIMEOUT_MS=30000
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000
IDEMPOTENCY_KEY_TTL=86400

# External Services
WALLET_SERVICE_URL=http://localhost:3002
PAYMENT_GATEWAY_URL=http://localhost:4000
PAYMENT_GATEWAY_API_KEY=test-api-key
PAYMENT_GATEWAY_TIMEOUT=10000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
